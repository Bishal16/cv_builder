# CV Builder — environment variable reference
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=cvbuilder
DB_PASSWORD=cvbuilder

# ── JWT ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens. Must be a long, random string in production.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=86400000

# ── URLs ─────────────────────────────────────────────────────────────────────
# Base URL the backend uses when opening the frontend for PDF export (Playwright).
# Local dev: http://localhost:5173
# Docker Compose: http://frontend  (points at the nginx container by service name)
FRONTEND_BASE_URL=http://localhost:5173

# Base URL used to build OAuth redirect URIs.
# Local dev: http://localhost:8081
# Production: https://api.yourdomain.com
OAUTH_REDIRECT_BASE_URL=http://localhost:8081

# Comma-separated origins allowed by the CORS filter (read by the prod profile).
# Local dev: http://localhost:5173
# Production: https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Credentials from https://console.cloud.google.com → APIs & Services → Credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Credentials from https://github.com/settings/developers → OAuth Apps → New OAuth App
# 1. Homepage URL: http://localhost:5173
# 2. Authorization callback URL: http://localhost:8081/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── AI features (suggestions, JD tailoring, cover letter, grammar, import) ─────
# Pick the LLM provider. Default is Gemini (free tier).
#   gemini    → set GEMINI_API_KEY
#   anthropic → set ANTHROPIC_API_KEY
#   openai    → set LLM_OPENAI_* (works with Groq / OpenRouter / Ollama)
# Leave the active provider's key blank to disable all AI features gracefully.
LLM_PROVIDER=gemini

# Gemini (recommended free option) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic (Claude) — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# OpenAI-compatible (Groq / OpenRouter / self-hosted Ollama)
# e.g. Groq:    LLM_OPENAI_BASE_URL=https://api.groq.com/openai/v1  model=llama-3.3-70b-versatile
# e.g. Ollama:  LLM_OPENAI_BASE_URL=http://localhost:11434/v1       model=llama3.1
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=

# ── Email (password reset) ─────────────────────────────────────────────────────
# Leave SMTP_HOST blank in dev — the reset link is logged to the console instead
# of being emailed. Set all four for real delivery (e.g. SendGrid, Mailgun, SES).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
