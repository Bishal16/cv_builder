# Copy this file to .env and fill in the values

# Database
DB_USERNAME=cvbuilder
DB_PASSWORD=cvbuilder

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=86400000

# Frontend URL (for Playwright PDF rendering)
FRONTEND_BASE_URL=http://localhost:5173

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Google OAuth2 (https://console.cloud.google.com/ → APIs & Services → Credentials)
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add Authorized redirect URI: http://localhost:8081/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth2 (https://github.com/settings/developers → OAuth Apps → New OAuth App)
# 1. Homepage URL: http://localhost:5173
# 2. Authorization callback URL: http://localhost:8081/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
